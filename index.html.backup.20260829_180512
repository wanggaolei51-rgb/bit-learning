.info-row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid rgba(42,53,80,.5);font-size:13px}
.info-label{color:var(--text-dim);flex-shrink:0;margin-right:12px}
.info-value{color:var(--text);text-align:right;word-break:break-word}
.project-title{font-size:14px;font-weight:700;color:var(--primary);margin:14px 0 6px;padding-bottom:4px;border-bottom:1px solid var(--border)}
.project-divider{height:1px;background:var(--border);margin:10px 0}
