}

function setDifficulty(diff) {
  prefixGameState.difficulty = diff;
  prefixGameState.phase = 'level2';
  showAffixLevel2(document.getElementById('appContent'));
}

// === 二级菜单 ===
function showAffixLevel2(c) {
  const state = prefixGameState;
  const catData = AFFIX_GAME_DATA[state.level1];
  if (!catData) { backToAffixLevel1(); return; }

  const children = Object.keys(catData.children);
  const buttons = children.map(k => {
    const d = catData.children[k];
