// ===== 单词点击翻译弹窗 =====
function wrapClickableWords(text){
  return text.replace(/([a-zA-ZÀ-ɏḀ-ỿ]+)/g,'<span class="clickable-word" data-word="$1">$1</span>');
}

// C4: 查找单词释义(含前缀去除)
function findVocab(word){
  const clean = word.toLowerCase().replace(/[^a-z]/g,'');
  let v = vocabDB[clean] || vocabDB[word.toLowerCase()];
  if(v) return v;
  if(clean.length>3){
    const prefixes = [['me','meng','meny','men','mem','me'],['ber','be'],['di'],['ter'],['pe','peng','peny','pen','pem'],['se']];
    for(const group of prefixes){
      for(const p of group){
        if(clean.startsWith(p) && clean.length>p.length+2){
          const root = clean.slice(p.length);
          v = vocabDB[root];
          if(v) return v;
          const changes = {m:'p',n:'t',ng:'k',ny:'s',r:''};
          for(const [to,from] of Object.entries(changes)){
            if(root.startsWith(to)){
              v = vocabDB[from+root.slice(to.length)];
              if(v) return v;
            }
          }
        }
      }
    }
  }
  return null;
}

function showWordPopup(word){
  const clean = word.toLowerCase().replace(/[^a-z]/g,'');
  let v = vocabDB[clean] || vocabDB[word.toLowerCase()];

  // 前缀去除查找
  if(!v && clean.length>3){
    const prefixes = [['me','meng','meny','men','mem','me'],['ber','be'],['di'],['ter'],['pe','peng','peny','pen','pem'],['se']];
    for(const group of prefixes){
      for(const p of group){
        if(clean.startsWith(p) && clean.length>p.length+2){
          const root = clean.slice(p.length);
          v = vocabDB[root];
          if(v) break;
          const changes = {m:'p',n:'t',ng:'k',ny:'s',r:''};
          for(const [to,from] of Object.entries(changes)){
            if(root.startsWith(to)){
              v = vocabDB[from+root.slice(to.length)];
              if(v) break;
            }
          }
        }
        if(v) break;
      }
      if(v) break;
    }
  }

  let existing = document.getElementById('wordPopupOverlay');
  if(existing) existing.remove();

  const overlay = document.createElement('div');
  overlay.id = 'wordPopupOverlay';
  overlay.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.6);z-index:9998;display:flex;align-items:center;justify-content:center;padding:16px;';

  const inWB = v ? wordBank.some(w=>w.word===v.id||w.id===v.id||w.id===clean) : false;
  const wid = v ? v.id : clean;

  let cardHTML = `<div id="wordPopupCard" style="background:var(--bg-card);border-radius:16px;padding:20px;max-width:360px;width:100%;border:1px solid var(--border);box-shadow:var(--shadow);position:relative;z-index:9999;max-height:90vh;overflow-y:auto;">
