function parseVocabInput(text) {
  const vocab = [];
  text.split("\\n").forEach(line => {
    line = line.trim();
    if (!line) return;
    const parts = line.split("-").map(s => s.trim());
    if (parts.length >= 2) {
      vocab.push({
        word: parts[0],
        cn: parts[1],
        ipa: parts[2] || ""
      });
    }
  });
  return vocab;
}

function generateAutoScenes(topicName, vocabList, scenesDesc) {
  // 基于话题名和词汇自动生成场景对话
  const scenes = [];
  const descLines = scenesDesc ? scenesDesc.split("\\n").filter(l => l.trim()) : [];

  const defaultScenes = [
    { title: "🎯 核心词汇学习", icon: "🎯", type: "vocab" },
    { title: "🎭 场景对话练习", icon: "🎭", type: "dialogue" },
    { title: "📖 阅读理解", icon: "📖", type: "reading" }
  ];

  const sceneTitles = descLines.length > 0 ? descLines.map((d, i) => ({
    title: d.replace(/^\\d+\\.\\s*/, "").trim() || defaultScenes[i]?.title || `场景 ${i+1}`,
    icon: ["🎯", "🎭", "📖", "💼", "🌐", "📊"][i] || "📝",
    type: i === 0 ? "vocab" : "dialogue"
  })) : defaultScenes;

  sceneTitles.forEach((sc, idx) => {
    const sceneVocab = vocabList.slice(idx * 3, idx * 3 + 5).map(v => v.word);
    const dialogue = [];

    if (sc.type === "vocab") {
      dialogue.push({speaker: "📢", text: `Selamat datang di pelajaran ${topicName}.`, trans: `欢迎来到${topicName}课程。`});
      dialogue.push({speaker: "👤", text: `Saya siap belajar.`, trans: `我准备好了。`});
    } else {
      dialogue.push({speaker: "A", text: `Selamat ${idx === 1 ? 'pagi' : 'siang'}, apa kabar?`, trans: `${idx === 1 ? '早上' : '下午'}好,你好吗?`});
      dialogue.push({speaker: "B", text: `Baik, terima kasih.`, trans: `很好,谢谢。`});
      dialogue.push({speaker: "A", text: `Mari kita mulai.`, trans: `让我们开始吧。`});
    }

    scenes.push({
      title: sc.title,
      icon: sc.icon,
      vocab: sceneVocab,
      dialogue: dialogue
    });
  });

  return scenes;
}

function generateAutoSpeeches(topicName, vocabList) {
  const speeches = [];

  // 3分钟演讲
  const keyWords = vocabList.slice(0, 8).map(v => v.word);
  speeches.push({
    title: `📜 3分钟演讲:${topicName}`,
    duration: "~3 menit",
    icon: "📜",
    words: 150 + Math.floor(Math.random() * 50),
    time: 180,
    content: `Assalamualaikum wr. wb.\\n\\nHari ini saya ingin berbicara tentang ${topicName}.\\n\\nPertama, ${topicName} sangat penting dalam kehidupan sehari-hari dan dunia bisnis. Kita sering menghadapi situasi yang memerlukan kemampuan ini.\\n\\nKedua, dalam konteks Indonesia, memahami ${topicName} membantu kita berkomunikasi lebih efektif dengan mitra lokal.\\n\\nKetiga, saya percaya bahwa dengan latihan yang konsisten, kita dapat menguasai ${topicName} dengan baik.\\n\\nTerima kasih. Wassalamualaikum wr. wb.`,
    trans: `大家好。\\n\\n今天我想谈谈${topicName}。\\n\\n首先,${topicName}在日常生活和商业世界中非常重要。我们经常遇到需要这种能力的情况。\\n\\n其次,在印度尼西亚的背景下,理解${topicName}有助于我们更有效地与当地合作伙伴沟通。\\n\\n第三,我相信通过持续的练习,我们可以很好地掌握${topicName}。\\n\\n谢谢。`
  });

  // 1分钟演讲
  speeches.push({
    title: `📊 1分钟演讲:我的${topicName}经验`,
    duration: "~1 menit",
    icon: "📊",
    words: 80,
    time: 60,
    content: `Selamat pagi. Saya ingin berbagi pengalaman saya tentang ${topicName}.\\n\\nDalam pekerjaan saya, saya sering menggunakan kosakata seperti ${keyWords.slice(0, 3).join(", ")}.\\n\\nSaya berharap kita semua dapat terus meningkatkan kemampuan berbahasa Indonesia. Terima kasih.`,
    trans: `早上好。我想分享我关于${topicName}的经验。\\n\\n在我的工作中,我经常使用诸如${keyWords.slice(0, 3).join(", ")}之类的词汇。\\n\\n希望我们都能继续提高印尼语能力。谢谢。`
  });

  return speeches;
}

