function renderWBList(){
  // C4: 同步vocabDB最新数据(修复旧数据"待补充"问题)
  wordBank.forEach(wb => {
    const fresh = vocabDB[wb.word];
    if (fresh && fresh.cn && fresh.cn !== '待补充' && fresh.cn !== wb.cn) {
      wb.cn = fresh.cn;
      wb.ipa = fresh.ipa || wb.ipa;
      wb.en = fresh.en || wb.en;
    }
  });
  const c=document.getElementById("wbList");if(!c)return;if(!wordBank.length){c.innerHTML=`<div class="wb-empty"><div class="big">📚</div><div>生词本为空</div></div>`;return;}
  let list = wordBank.map((w,origIdx)=>({...w,origIdx}));
  if(wbDateFilter){
    list = list.filter(w=>{
      if(!w.date) return true; // 兼容旧数据：无date字段的词汇默认显示
      return w.date===wbDateFilter;
    });
  }
  if(wbSearchQuery){
    list = list.filter(w=>(w.word||"").toLowerCase().includes(wbSearchQuery)||(w.cn||"").includes(wbSearchQuery)||(w.en||"").toLowerCase().includes(wbSearchQuery));
  }
  if(wbSortMode==="alpha"){
    list.sort((a,b)=>(a.word||"").localeCompare(b.word||"","id"));
  }else{
    list.sort((a,b)=>{const ta=new Date(a.date||0).getTime();const tb=new Date(b.date||0).getTime();return tb-ta;});
  }
  let h="";list.forEach((w,li)=>{
    const i = w.origIdx;
    const p = w.passed || {id2zh:false,zh2id:false,spell:false};
    const allDone = p.id2zh && p.zh2id && p.spell;
    const progress = (p.id2zh?1:0)+(p.zh2id?1:0)+(p.spell?1:0);
    h+=`<div class="wb-item" style="${allDone?'border-color:var(--success);opacity:.7':''}"><div><div class="wb-w">${w.word} <span class="wb-i">${w.ipa||""}</span></div><div class="wb-m">🇨🇳 ${w.cn||""}</div>
      <div style="display:flex;gap:6px;margin-top:6px;font-size:11px">
        <span style="padding:2px 6px;border-radius:4px;background:${p.id2zh?'rgba(34,197,94,.15)':'rgba(239,68,68,.08)'};color:${p.id2zh?'var(--success)':'var(--danger)'}">🇮🇩→🇨🇳 ${p.id2zh?'✅':'❌'}</span>
        <span style="padding:2px 6px;border-radius:4px;background:${p.zh2id?'rgba(34,197,94,.15)':'rgba(239,68,68,.08)'};color:${p.zh2id?'var(--success)':'var(--danger)'}">🇨🇳→🇮🇩 ${p.zh2id?'✅':'❌'}</span>
        <span style="padding:2px 6px;border-radius:4px;background:${p.spell?'rgba(34,197,94,.15)':'rgba(239,68,68,.08)'};color:${p.spell?'var(--success)':'var(--danger)'}">✏️ ${p.spell?'✅':'❌'}</span>
        <span style="color:var(--text-dim)">${progress}/3</span>
      </div>
      <div class="wb-act">
        <button class="wb-mas" onclick="playWBGame('${w.word}')">🎮 练习</button>
        <button class="wb-del" onclick="delWB(${i})">🗑️</button>
      </div></div></div>`;
  });
  if(list.length===0&&wbSearchQuery){c.innerHTML=`<div class="wb-empty"><div class="big">🔍</div><div>无匹配 "${wbSearchQuery}" 的生词</div></div>`;return;}
  if(list.length===0&&wbDateFilter){c.innerHTML=`<div class="wb-empty"><div class="big">📅</div><div>${wbDateFilter} 暂无生词</div><div style="font-size:12px;margin-top:6px;color:var(--text-dim)">该课程日期下没有已保存的生词</div></div>`;return;}
  c.innerHTML=h;
}

function playWBGame(word) {if(!checkAccess("生词练习"))return;
  const w = wordBank.find(x => x.word === word); if (!w) return;
  const p = w.passed || {id2zh:false,zh2id:false,spell:false};
  let mode = 'id2zh';
  if (!p.id2zh) mode = 'id2zh';
  else if (!p.zh2id) mode = 'zh2id';
  else if (!p.spell) mode = 'spell';
  else mode = 'id2zh';
  // 针对单个单词的练习池
  gameState = { mode, pool: [w], current: null, q: 0, correct: 0, wrong: 0, total: 1, streak: 0, wrongAnswers: [] };
  navigate('game'); setTimeout(() => showGameQ(), 300);
}

function delWB(i){
  const w = wordBank[i]; if (!w) return;
  const p = w.passed || {id2zh:false,zh2id:false,spell:false};
  if (!(p.id2zh && p.zh2id && p.spell)) { showToast("❌ 三关未全过,不能移除!"); return; }
  if(!confirm("三关已通过,确认删除?"))return;
  wordBank.splice(i,1);saveWB();renderWBList();updateStats();showToast("已删除");
}

function exportWB(){
  if(!wordBank.length){showToast("为空");return;}
  let t=`📚 BIR生词本-${new Date().toISOString().slice(0,10)}\n\n=== 三关全过 ===\n`;
  wordBank.filter(w=>{const p=w.passed||{id2zh:false,zh2id:false,spell:false};return p.id2zh&&p.zh2id&&p.spell;}).forEach((w,i)=>{t+=`${i+1}. ${w.word} ${w.ipa}\n  🇨🇳${w.cn}\n`; });
  t+=`\n=== 进行中 ===\n`;
  wordBank.filter(w=>{const p=w.passed||{id2zh:false,zh2id:false,spell:false};return !(p.id2zh&&p.zh2id&&p.spell);}).forEach((w,i)=>{const p=w.passed||{id2zh:false,zh2id:false,spell:false};t+=`${i+1}. ${w.word} ${w.ipa}\n  🇨🇳${w.cn}\n  进度: 🇮🇩→🇨🇳${p.id2zh?'✅':'❌'} 🇨🇳→🇮🇩${p.zh2id?'✅':'❌'} ✏️${p.spell?'✅':'❌'}\n`; });
  navigator.clipboard.writeText(t).then(()=>showToast("已复制"));
}

