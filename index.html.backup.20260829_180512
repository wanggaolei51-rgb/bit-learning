function searchNickelMap(query) {
  if (!query || !nickelMap) return;
  const q = query.toLowerCase().trim();
  if (!q) return;
  for (const [key, group] of Object.entries(nickelData.indonesia)) {
    const texts = [
      group.park || "", group.province || "",
      ...(group.projects || []).flatMap(p => [
        p["项目名"] || "", p["企业名_中文"] || "", p["企业名_英文_PT"] || "",
        p["工艺路线"] || "", p["产品"] || "", p["状态"] || ""
      ])
    ];
    if (texts.some(t => t.toLowerCase().includes(q))) {
      nickelMap.flyTo([group.lat, group.lng], 11, { duration: 1.5 });
      setTimeout(() => showIndonesiaPopup(key, group), 1600);
      return;
    }
  }
  for (const p of nickelData.global) {
    const texts = [
      p["国家"] || "", p["企业名_中文"] || "", p["项目名"] || "", p["状态"] || ""
    ];
    if (texts.some(t => (t || "").toLowerCase().includes(q))) {
      nickelMap.flyTo([p.lat, p.lng], 8, { duration: 1.5 });
      const popupContent = "<b>" + escapeHtml(p["国家"]) + "</b><br>" +
        escapeHtml(p["企业名_中文"] || p["项目名"]) + "<br>" +
        (p["年产能_万镍金属吨"] ? p["年产能_万镍金属吨"] + "万镍吨/年" : "");
      L.popup({ offset: [0, -10] }).setLatLng([p.lat, p.lng]).setContent(popupContent).openOn(nickelMap);
      return;
    }
  }
  alert("未找到匹配的企业或项目: \"" + query + "\"");
}
