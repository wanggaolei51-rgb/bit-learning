// 从本地词汇表和生词本抽取词根,动态扩展词库
function buildDynamicWordPool() {
  const pool = [];
  // 从生词本提取
  try {
    const vw = JSON.parse(localStorage.getItem('vocabWords') || '[]');
    vw.forEach(w => {
      if (w.ind && w.cn) {
        pool.push({ root: w.ind.replace(/^(me|mem|men|meng|meny|di|ter|ber|pe|pen|peng|pem|se|ke)/, ''), full: w.ind, cn: w.cn });
      }
    });
  } catch(e) {}
  // 从词汇表提取
  try {
    const vocab = JSON.parse(localStorage.getItem('vocab') || '[]');
    vocab.forEach(w => {
      if (w.ind && w.cn) {
        pool.push({ root: w.ind.replace(/^(me|mem|men|meng|meny|di|ter|ber|pe|pen|peng|pem|se|ke)/, ''), full: w.ind, cn: w.cn });
      }
    });
  } catch(e) {}
  return pool;
}

