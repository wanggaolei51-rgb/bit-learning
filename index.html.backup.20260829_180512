  const intervals = [1, 2, 4, 7, 15, 30, 60, 90];
  const ebbinghausItems = [];

  // 基于topicCalendar计算复习日:每个话题日期都是学习日
  Object.entries(topicCalendar).forEach(([date, tc]) => {
    const learnDate = new Date(date);
    intervals.forEach(iv => {
      const reviewDate = new Date(learnDate);
      reviewDate.setDate(learnDate.getDate() + iv);
      const rdStr = reviewDate.toISOString().split('T')[0];
      if (rdStr === today) {
        const d = topicData[tc.topic];
        ebbinghausItems.push({
          topic: tc.topic,
          learnDate: date,
          day: iv,
          title: d ? d.title : tc.topic,
