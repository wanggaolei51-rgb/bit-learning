function loadPresetMIR(){
  const content = document.getElementById('mirModalContent');
  if(!content) return;
  
  let html = '<div style="margin-bottom:16px">';
  html += '<div style="font-size:13px;color:var(--text-dim);margin-bottom:12px">📌 以下数据为演示格式，实际部署后将接入SIO战略情报官实时获取</div>';
  
  MIR_PRESETS.forEach(cat => {
    html += '<div style="margin-bottom:16px;border:1px solid var(--border);border-radius:10px;overflow:hidden">';
    html += '<div style="background:var(--bg-elev);padding:10px 14px;font-size:13px;font-weight:600;color:var(--primary);display:flex;align-items:center;gap:6px">' + cat.icon + ' ' + cat.label + '</div>';
    html += '<div style="padding:10px 14px">';
    
    // Price items
    cat.items.forEach(item => {
      const trendColor = item.trend === 'up' ? '#22c55e' : item.trend === 'down' ? '#ef4444' : 'var(--text-dim)';
      const trendIcon = item.trend === 'up' ? '↗' : item.trend === 'down' ? '↘' : '→';
      html += '<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid rgba(255,255,255,0.05)">';
      html += '<div style="font-size:12px;color:var(--text)">' + item.name + '</div>';
      html += '<div style="text-align:right">';
      html += '<div style="font-size:13px;font-weight:600;color:var(--text)">' + item.value + '</div>';
      html += '<div style="font-size:11px;color:' + trendColor + '">' + trendIcon + ' ' + item.change + '</div>';
      html += '</div>';
      html += '</div>';
    });
    html += '<div style="font-size:10px;color:var(--text-dim);margin-top:6px;text-align:right">来源：' + cat.items[0].source + '</div>';
    
    // Quality section
    if(cat.quality && cat.quality.length > 0){
      html += '<div style="margin-top:12px;padding-top:10px;border-top:1px solid rgba(255,255,255,0.05)">';
      html += '<div style="font-size:11px;font-weight:600;color:var(--accent);margin-bottom:8px">📋 品质指标 / Quality Specs</div>';
      cat.quality.forEach(q => {
        html += '<div style="display:flex;justify-content:space-between;align-items:center;padding:4px 0;font-size:11px">';
        html += '<span style="color:var(--text-dim)">' + q.name + '</span>';
        html += '<span style="color:var(--text);font-weight:600">' + q.value + '</span>';
        html += '</div>';
        html += '<div style="font-size:10px;color:var(--text-dim);margin-bottom:4px">' + q.desc + '</div>';
      });
      html += '</div>';
    }
    
    // News section
    if(cat.news && cat.news.length > 0){
      html += '<div style="margin-top:10px;padding-top:10px;border-top:1px solid rgba(255,255,255,0.05)">';
      html += '<div style="font-size:11px;font-weight:600;color:var(--accent);margin-bottom:8px">📰 行业资讯 / Industry News</div>';
      cat.news.forEach(news => {
        html += '<div style="font-size:11px;color:var(--text);line-height:1.5;margin-bottom:4px;padding:4px 8px;background:rgba(0,0,0,.15);border-radius:4px">' + news + '</div>';
      });
      html += '</div>';
    }
    
    // Tech section
    if(cat.tech && cat.tech.length > 0){
      html += '<div style="margin-top:10px;padding-top:10px;border-top:1px solid rgba(255,255,255,0.05)">';
      html += '<div style="font-size:11px;font-weight:600;color:var(--accent);margin-bottom:8px">🔬 科技动态 / Tech Updates</div>';
      cat.tech.forEach(tech => {
        html += '<div style="font-size:11px;color:var(--text);line-height:1.5;margin-bottom:4px;padding:4px 8px;background:rgba(0,0,0,.15);border-radius:4px">' + tech + '</div>';
      });
      html += '</div>';
    }
    
    html += '</div></div>';
  });
  
  html += '</div>';
  
  // Custom query section at bottom
  html += '<div style="border-top:1px solid var(--border);padding-top:16px;margin-top:16px">';
  html += '<div style="font-size:13px;font-weight:600;color:var(--accent);margin-bottom:10px">🔍 自定义查询 / Custom Query</div>';
  html += '<div style="display:flex;gap:8px">';
  html += '<input type="text" id="mirQueryInput" placeholder="输入关键词，如：钴价、稀土、光伏..." onkeydown="if(event.key===\'Enter\'){event.preventDefault();queryMIR()}" style="flex:1;padding:10px 14px;background:var(--bg-elev);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;outline:none">';
  html += '<button onclick="queryMIR()" style="padding:10px 20px;background:var(--primary);color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:13px;white-space:nowrap">查询</button>';
  html += '</div>';
  html += '<div id="mirCustomResult" style="margin-top:12px"></div>';
  html += '</div>';
  
  content.innerHTML = html;
}

function queryMIR(){
  const input = document.getElementById('mirQueryInput');
  const query = input ? input.value.trim() : '';
  const resultEl = document.getElementById('mirCustomResult');
  if(!resultEl) return;
  if(!query){
    resultEl.innerHTML = '<div style="color:var(--text-dim);font-size:12px;padding:8px">请输入查询关键词</div>';
    return;
  }
  resultEl.innerHTML = '<div style="text-align:center;padding:20px;color:var(--text-dim)"><div style="font-size:24px;margin-bottom:8px">🤖</div><div style="font-size:13px">正在通过SIO战略情报官获取「' + escapeHtml(query) + '」相关信息...</div><div style="font-size:11px;margin-top:8px;color:var(--primary)">[接口预留] 后续将接入真实MIR Agent调用</div></div>';
  // TODO: Connect to real MIR agent API
  // fetch('/api/mir?query=' + encodeURIComponent(query)).then(...)
}
