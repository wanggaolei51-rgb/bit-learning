.pie-chart{width:100px;height:100px;border-radius:50%;margin:0 auto;position:relative}
.pie-legend{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:10px;font-size:11px}
.pie-legend-item{display:flex;align-items:center;gap:4px}
.pie-dot{width:10px;height:10px;border-radius:3px}

