function renderDailyQuiz(c) {
  const today = new Date().toISOString().slice(0,10);
  const tc = topicCalendar[today] || Object.values(topicCalendar).find(t => t.date === today);

  // 收集所有可用的话题/课时(按话题去重,C4架构:一个话题一个测试)
  const availableTopics = [];
  const seenTopics = new Set();
  Object.keys(topicCalendar).forEach(date => {
    const info = topicCalendar[date];
    if (info && info.topic) {
      // C4: 一个话题只生成一个测试,去重
      if (seenTopics.has(info.topic)) return;
      seenTopics.add(info.topic);
      const topic = topicData[info.topic];
      if (topic) {
        availableTopics.push({
          date: date,
          topicKey: info.topic,
          topic: topic,
          day: info.day || 1,
          label: info.label || `Day ${info.day || 1}`,
          isToday: date === today
        });
      }
    }
  });

  // 按日期排序
  availableTopics.sort((a, b) => a.date.localeCompare(b.date));

  if (availableTopics.length === 0) {
    c.innerHTML = `<div class="card"><div class="card-header"><h2>🎯 课时测试</h2></div><div style="padding:20px;text-align:center;color:var(--text-dim);">暂无可用课时,请先学习课程</div></div>`;
    return;
  }

  // 生成话题选择卡片
  let topicsHtml = availableTopics.map(t => {
