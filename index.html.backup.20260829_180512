function switchIndustryTab(tab){
  document.querySelectorAll('.industry-tab').forEach(b=>{
    b.style.background='var(--bg-elev)';
    b.style.color='var(--text)';
    b.classList.remove('active');
  });
  const activeBtn=document.querySelector('.industry-tab[data-tab="'+tab+'"]');
  if(activeBtn){
    activeBtn.style.background='var(--primary)';
    activeBtn.style.color='#fff';
    activeBtn.classList.add('active');
  }
  
  // ===== NICKEL TAB: Use full nickelData =====
  if(tab === 'nickel'){
    switchNickelTab();
    return;
  }
  
  const data = industryData[tab];
  if(!data) return;
  
  // Init or update map
  const container = document.getElementById('industryMapContainer');
  if(!container) return;
  
  if(!industryMap){
    container.innerHTML = '';
    industryMap = L.map('industryMapContainer').setView([-2.5, 120], 5);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; OSM & CARTO', subdomains: 'abcd', maxZoom: 19
    }).addTo(industryMap);
