      </div>
      <div style="padding:24px;text-align:center;">
        <div style="font-size:13px;color:var(--text-dim);margin-bottom:20px;">选择适合你的挑战级别</div>
        <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
          ${buttons}
        </div>
      </div>
