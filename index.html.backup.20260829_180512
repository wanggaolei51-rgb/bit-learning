// 自动同步14号以后所有课程生词到生词本
function syncCourseVocabToWordBank() {
  if (!wordBank) return;
  let added = 0;
  const existingWords = new Set(wordBank.map(w => (w.word || w.id || '').toLowerCase()));

  // 建立 topicKey -> date 反向映射
  const topicDateMap = {};
  for (const [ds, info] of Object.entries(topicCalendar || {})) {
    if (info && info.topic) {
      topicDateMap[info.topic] = ds;
    }
  }

  function addIfNew(word, cn, en, ipa, root, tag, date) {
    const w = (word || '').trim();
    if (!w || w.length < 2) return;
    const key = w.toLowerCase();
    if (existingWords.has(key)) return;
    existingWords.add(key);
    wordBank.push({
      id: key, word: w, zh: cn || w, cn: cn || w, en: en || '',
      ipa: ipa || '-', root: root || '-', tag: tag || '课程同步',
      date: date || new Date().toISOString().slice(0,10),
      passed: {}, addTime: Date.now()
    });
    added++;
  }

  // Sync topicData (meet, introduce, directions, common_sentences, weather, medical)
  for (const [topicKey, topic] of Object.entries(topicData)) {
    const topicDate = topicDateMap[topicKey] || '';
    // Sync vocabulary (NEW: common_sentences, weather, medical)
    if (topic.vocabulary) {
      topic.vocabulary.forEach(v => {
        addIfNew(
          v.indonesian || v.word || v.id || '',
          v.chinese || v.cn || v.zhs || '',
          v.english || v.en || '',
          v.ipa || '',
          v.morphology || v.root || '',
          '话题:' + topicKey,
          topicDate
        );
      });
    }
    // Sync scenes/dialogue
    if (topic.scenes) {
      topic.scenes.forEach(sc => {
        if (sc.dialogue) {
          sc.dialogue.forEach(d => {
            if (d.text) {
              d.text.split(/[\s.,!?;:"'-]+/).forEach(tok => {
                const t = tok.trim().toLowerCase();
                if (t.length >= 3 && /^[a-z]+$/.test(t)) {
                  const v = vocabDB[t] || vocabDB[t.charAt(0).toUpperCase() + t.slice(1)];
                  if (v) addIfNew(t, v.cn, v.en, v.ipa, v.root, '话题:' + topicKey, topicDate);
                }
              });
            }
          });
        }
      });
    }
    // Sync speeches
    if (topic.speeches) {
      topic.speeches.forEach(sp => {
        if (sp.content) {
          sp.content.split(/[\s.,!?;:"'-]+/).forEach(tok => {
            const t = tok.trim().toLowerCase();
            if (t.length >= 3 && /^[a-z]+$/.test(t)) {
              const v = vocabDB[t] || vocabDB[t.charAt(0).toUpperCase() + t.slice(1)];
              if (v) addIfNew(t, v.cn, v.en, v.ipa, v.root, '话题:' + topicKey, topicDate);
            }
          });
        }
      });
    }
    // Sync grammar.examples (NEW: common_sentences, weather, medical, and all topics)
    if (topic.grammar && topic.grammar.examples) {
      topic.grammar.examples.forEach(ex => {
        const text = typeof ex === 'string' ? ex : (ex.ind || ex.indonesian || '');
        if (text) {
          // Extract Indonesian part before "=" if present
          const indPart = text.split('=')[0].trim();
          indPart.split(/[\s.,!?;:"'-]+/).forEach(tok => {
            const t = tok.trim().toLowerCase();
            if (t.length >= 3 && /^[a-z]+$/.test(t)) {
              const v = vocabDB[t] || vocabDB[t.charAt(0).toUpperCase() + t.slice(1)];
              if (v) addIfNew(t, v.cn, v.en, v.ipa, v.root, '话题:' + topicKey, topicDate);
            }
          });
        }
      });
    }
    // Sync grammar.rules for key vocabulary mentions
    if (topic.grammar && topic.grammar.rules) {
      topic.grammar.rules.forEach(rule => {
        if (typeof rule === 'string') {
          rule.split(/[\s.,!?;:"'()-]+/).forEach(tok => {
            const t = tok.trim().toLowerCase();
            if (t.length >= 3 && /^[a-z]+$/.test(t)) {
              const v = vocabDB[t] || vocabDB[t.charAt(0).toUpperCase() + t.slice(1)];
              if (v) addIfNew(t, v.cn, v.en, v.ipa, v.root, '话题:' + topicKey, topicDate);
            }
          });
        }
      });
    }
  }

  // Sync nickelCurriculum
  for (const [ds, lesson] of Object.entries(nickelCurriculum)) {
    if (lesson.items) {
      lesson.items.forEach(item => {
        addIfNew(item.indonesian || item.ind || '', item.chinese || item.zhs || '',
                 item.english || item.en || '', item.ipa || '', item.morphology || '', '镍产业:' + ds);
      });
    }
    if (lesson.dialogues) {
      lesson.dialogues.forEach(dg => {
        if (dg.lines) {
          dg.lines.forEach(line => {
            const text = line.ind || line.indonesian || '';
            if (text) {
              text.split(/[\s.,!?;:"'-]+/).forEach(tok => {
                const t = tok.trim().toLowerCase();
                if (t.length >= 3 && /^[a-z]+$/.test(t)) {
                  const v = vocabDB[t] || vocabDB[t.charAt(0).toUpperCase() + t.slice(1)];
                  if (v) addIfNew(t, v.cn, v.en, v.ipa, v.root, '镍产业:' + ds);
                }
              });
            }
          });
        }
      });
    }
    if (lesson.passages) {
      lesson.passages.forEach(p => {
        const lines = p.lines || p.sentences || [];
        lines.forEach(line => {
          const text = line.ind || line.indonesian || '';
          if (text) {
            text.split(/[\s.,!?;:"'-]+/).forEach(tok => {
              const t = tok.trim().toLowerCase();
              if (t.length >= 3 && /^[a-z]+$/.test(t)) {
                const v = vocabDB[t] || vocabDB[t.charAt(0).toUpperCase() + t.slice(1)];
                if (v) addIfNew(t, v.cn, v.en, v.ipa, v.root, '镍产业:' + ds);
              }
            });
          }
        });
      });
    }
    if (lesson.sentence_patterns) {
      lesson.sentence_patterns.forEach(sp => {
        if (sp.example) {
          sp.example.split(/[\s.,!?;:"'-]+/).forEach(tok => {
            const t = tok.trim().toLowerCase();
            if (t.length >= 3 && /^[a-z]+$/.test(t)) {
              const v = vocabDB[t] || vocabDB[t.charAt(0).toUpperCase() + t.slice(1)];
              if (v) addIfNew(t, v.cn, v.en, v.ipa, v.root, '镍产业:' + ds);
            }
          });
        }
      });
    }
    if (lesson.grammar) {
      lesson.grammar.forEach(g => {
        if (g.examples) {
          g.examples.forEach(ex => {
            const text = ex.ind || ex.indonesian || '';
            if (text) {
              text.split(/[\s.,!?;:"'-]+/).forEach(tok => {
                const t = tok.trim().toLowerCase();
                if (t.length >= 3 && /^[a-z]+$/.test(t)) {
                  const v = vocabDB[t] || vocabDB[t.charAt(0).toUpperCase() + t.slice(1)];
                  if (v) addIfNew(t, v.cn, v.en, v.ipa, v.root, '镍产业:' + ds);
                }
              });
            }
          });
        }
      });
    }
  }

  if (added > 0) { saveWB(); updateStats(); }
  console.log('[BIR C4] 课程生词同步完成,新增 ' + added + ' 个词汇');
}

