function addWB(word,ipa,cn,en,root,tag){if(!checkAccess("添加生词"))return;const existing=wordBank.find(w=>w.word.toLowerCase()===word.toLowerCase());if(existing){let updated=false;if(ipa&&ipa!=="-"&&ipa!==""){existing.ipa=ipa;updated=true;}if(cn&&cn!=="-"&&cn!=="待补充"&&cn!==""){existing.cn=cn;updated=true;}if(en&&en!=="-"&&en!==""){existing.en=en;updated=true;}if(root&&root!=="-"&&root!==""){existing.root=root;updated=true;}if(tag&&tag!=="-"&&tag!==""){existing.tag=tag;updated=true;}if(updated){saveWB();showToast("「"+word+"」翻译已同步更新");updateStats();}else{showToast("已在生词本");}return;}wordBank.unshift({word,ipa:ipa||"-",cn:cn||"-",en:en||"-",root:root||"-",tag:tag||"-",date:new Date().toISOString().slice(0,10),mastered:false});saveWB();showToast("「"+word+"」已保存");updateStats();}
function toggleWB(i){wordBank[i].mastered=!wordBank[i].mastered;saveWB();renderWBList();updateStats();}
function removeMasteredWB(i) {
  const w = wordBank[i];
  if (!w) return;
  const p = w.passed || {};
  if (!p.id2zh || !p.zh2id || !p.spell) { showToast('该词尚未三关全过,无法移除'); return; }
  if (!confirm(`确认移除已掌握单词: ${w.word}?`)) return;
  wordBank.splice(i, 1);
  saveWB();
  renderWBList();
  updateStats();
  showToast('✅ 已掌握,从生词本移除');
}
