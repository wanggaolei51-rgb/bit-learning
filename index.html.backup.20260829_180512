// C4: 绑定单词→中文翻译精确高亮
function bindWordTransHighlight(item, transSelector) {
  const trans = item.querySelector(transSelector);
  if (!trans) return;
  const originalText = trans.textContent;
  // 存储原始文本用于恢复
  trans.dataset.original = originalText;

  item.querySelectorAll('.clickable-word').forEach(word => {
    word.addEventListener('mouseenter', () => {
      const w = word.dataset.word;
      if (!w) return;
      const v = findVocab(w);
      if (v && v.cn) {
        // 在中文翻译中查找该释义,精确高亮匹配部分
        const idx = originalText.indexOf(v.cn);
        if (idx >= 0) {
          const before = originalText.slice(0, idx);
          const match = originalText.slice(idx, idx + v.cn.length);
          const after = originalText.slice(idx + v.cn.length);
          trans.innerHTML = escapeHtml(before) + '<span style="color:var(--primary);font-weight:600;background:rgba(0,212,170,.15);padding:2px 4px;border-radius:4px;transition:all .15s;">' + escapeHtml(match) + '</span>' + escapeHtml(after);
        } else {
          // 整句翻译中无匹配,显示轻量 tooltip
          showWordMiniTooltip(word, v.cn);
        }
      }
    });
    word.addEventListener('mouseleave', () => {
      // 恢复原始文本
      if (trans.dataset.original) {
        trans.innerHTML = escapeHtml(trans.dataset.original);
      }
      hideWordMiniTooltip();
    });
  });
}

// HTML 转义
function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

// 轻量单词 tooltip
let _miniTooltip = null;
function showWordMiniTooltip(targetEl, text) {
  hideWordMiniTooltip();
  const rect = targetEl.getBoundingClientRect();
  const tip = document.createElement('div');
  tip.id = 'wordMiniTooltip';
  tip.style.cssText = 'position:fixed;z-index:9999;background:var(--bg-card);border:1px solid var(--primary);border-radius:8px;padding:6px 10px;font-size:12px;color:var(--primary);font-weight:600;box-shadow:var(--shadow);pointer-events:none;transition:opacity .15s;';
  tip.textContent = '🇨🇳 ' + text;
  document.body.appendChild(tip);
  const tipRect = tip.getBoundingClientRect();
  let top = rect.top - tipRect.height - 6;
  let left = rect.left + (rect.width - tipRect.width) / 2;
  if (top < 4) top = rect.bottom + 6;
  if (left < 4) left = 4;
  if (left + tipRect.width > window.innerWidth - 4) left = window.innerWidth - tipRect.width - 4;
  tip.style.top = top + 'px';
  tip.style.left = left + 'px';
  _miniTooltip = tip;
}
function hideWordMiniTooltip() {
  if (_miniTooltip) { _miniTooltip.remove(); _miniTooltip = null; }
}

