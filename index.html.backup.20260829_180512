function initNickelMap() {
  if (nickelMap) { nickelMap.remove(); nickelMap = null; }
  const mapContainer = document.getElementById('leaflet-map');
  if (!mapContainer) return;
  mapContainer.innerHTML = '';
  nickelMap = L.map('leaflet-map').setView([-2.5, 120], 5);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
    attribution: '&copy; OSM & CARTO', subdomains: 'abcd', maxZoom: 19
  }).addTo(nickelMap);

  let indoCount = 0, globalCount = 0, totalCap = 0;

  Object.keys(nickelData.indonesia).forEach(key => {
    const group = nickelData.indonesia[key];
    if (!group.lat || !group.lng) return;
    const count = group.projects.length;
    const cap = group.projects.reduce((s, p) => s + (parseFloat(p['年产能_万镍金属吨']) || 0), 0);
    totalCap += cap; indoCount += count;
    const marker = L.circleMarker([group.lat, group.lng], {
      radius: 10, fillColor: '#00A896', color: '#00d4aa', weight: 2, opacity: 1, fillOpacity: 0.85
    }).addTo(nickelMap);
    marker.bindTooltip('<b>' + group.park + '</b><br>' + group.province + '<br>' + count + '个项目 · ' + cap.toFixed(1) + '万镍吨', { direction: 'top', offset: [0, -10] });
    marker.on('click', () => showIndonesiaPopup(key, group));
  });

  nickelData.global.forEach(p => {
    if (!p.lat || !p.lng) return;
    globalCount++;
    const cap = parseFloat(p['年产能_万镍金属吨']) || 0;
    L.circleMarker([p.lat, p.lng], {
      radius: 6, fillColor: getStatusColor(p['状态']), color: '#fff', weight: 1, opacity: 0.8, fillOpacity: 0.7
    }).addTo(nickelMap).bindTooltip('<b>' + escapeHtml(p['国家']) + '</b><br>' + escapeHtml(p['企业名_中文'] || p['项目名']) + '<br>' + cap.toFixed(1) + '万镍吨', { direction: 'top' });
  });

  const statsEl = document.getElementById('mapStats');
  if (statsEl) statsEl.innerHTML = '🇮🇩 ' + indoCount + '项目 · 🌍 ' + globalCount + '项目 · 总产能 ' + totalCap.toFixed(1) + '万镍吨/年';
}

