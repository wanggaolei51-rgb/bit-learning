          🔥 <strong>连击</strong>:连续正确触发Combo特效与加分<br>
          💡 <strong>解析</strong>:错误时显示规则详解,边玩边学<br>
          ⭐ <strong>成就</strong>:解锁关卡、收集星级、挑战大师难度
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;">
          ${buttons}
        </div>
        ${renderAchievementsPreview()}
      </div>
    </div>
  `;
}

function renderAchievementsPreview() {
  const achieved = Object.keys(prefixGameState.achievements).length;
  const total = Object.keys(ACHIEVEMENTS).length;
  if (achieved === 0) return '';
  return `
    <div style="margin-top:20px;padding:14px;background:var(--bg-elev);border-radius:10px;text-align:center;">
      <div style="font-size:13px;color:var(--text-dim);margin-bottom:8px">🏆 成就进度</div>
      <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
        ${Object.values(prefixGameState.achievements).map(a => `<span style="font-size:20px" title="${a.name}">${a.icon}</span>`).join('')}
      </div>
      <div style="font-size:11px;color:var(--text-dim);margin-top:6px">${achieved} / ${total} 已解锁</div>
