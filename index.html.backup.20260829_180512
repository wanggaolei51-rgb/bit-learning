      '硫铁矿制酸': { label: '🟤 硫铁矿制酸', color: '#d97706' },
      '冶炼副产酸': { label: '⚙️ 冶炼副产酸', color: '#6b7280' }
    },
    power: {
      '燃煤': { label: '🟤 燃煤发电', color: '#78716c' },
      '水电': { label: '💧 水力发电', color: '#0ea5e9' },
      '燃气': { label: '🔵 燃气发电', color: '#3b82f6' },
      '余热': { label: '🟠 余热发电', color: '#f97316' }
    },
    aluminum: {
      '电解铝': { label: '⚡ 电解铝', color: '#8b5cf6' },
      '氧化铝': { label: '⬜ 氧化铝', color: '#a8a29e' }
    }
