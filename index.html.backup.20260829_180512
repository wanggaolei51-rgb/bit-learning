  function renderNode(node, index, parentExpanded = false) {
    const hasChildren = node.children && node.children.length;
    const nodeId = `mm-${ds}-${index}`;
    // 四级思维导图:一级到三级默认展开,四级直接显示
    const shouldExpand = node.level <= 3;
    const isLevel4 = node.level === 4;
    let h = `<div style="margin:${isLevel4 ? '3px 0' : '6px 0'};">`;
    h += `<div class="mindmap-node" data-node="${nodeId}" style="cursor:${hasChildren ? 'pointer' : 'default'};display:flex;align-items:center;gap:8px;padding:${node.level === 1 ? '10px 14px' : node.level === 2 ? '8px 12px' : node.level === 3 ? '6px 10px' : '4px 8px'};border-radius:8px;background:${node.level === 1 ? 'rgba(0,212,170,.15)' : node.level === 2 ? 'rgba(59,130,246,.1)' : node.level === 3 ? 'rgba(255,255,255,.03)' : 'rgba(255,255,255,.015)'};border-left:3px solid ${node.color || 'var(--primary)'};transition:all .2s;${node.level === 3 ? 'margin-left:12px;' : node.level === 4 ? 'margin-left:24px;' : ''}" onclick="${hasChildren ? `toggleMindmapNode('${nodeId}')` : ''}">`;
    h += `<span style="font-size:12px;color:var(--text-dim);transition:transform .2s;${hasChildren ? '' : 'visibility:hidden;'}" id="icon-${nodeId}">${hasChildren ? (shouldExpand ? '▼' : '▶') : '•'}</span>`;
    h += `<span style="font-size:${node.level === 1 ? '15px' : node.level === 2 ? '14px' : node.level === 3 ? '13px' : '12px'};font-weight:${node.level <= 2 ? '600' : node.level === 3 ? '400' : '400'};color:${node.color || (isLevel4 ? 'var(--text-dim)' : 'var(--text)')};">${node.title}</span>`;
    h += `</div>`;
    if (hasChildren) {
      h += `<div id="children-${nodeId}" style="margin-left:20px;padding-left:12px;border-left:2px dashed var(--border);display:${shouldExpand ? 'block' : 'none'};">`;
      node.children.forEach((child, ci) => {
        h += renderNode(child, `${index}-${ci}`, shouldExpand);
      });
      h += `</div>`;
    }
    // Level 4 detail tooltip line
    if (isLevel4 && node.detail) {
      h += `<div style="margin-left:32px;margin-top:2px;font-size:11px;color:var(--text-dim);padding-left:8px;border-left:2px solid rgba(0,212,170,.2);">${node.detail}</div>`;
    }
    h += `</div>`;
    return h;
  }

  html += `<div style="padding:8px;">`;
  mindmapData.forEach((node, i) => {
    html += renderNode(node, i);
  });
  html += `</div>`;

  html += `<div style="margin-top:16px;padding:12px;background:rgba(34,197,94,.08);border-radius:8px;border:1px solid rgba(34,197,94,.3)"><div style="font-size:13px;color:var(--success)">✅ 思维导图梳理完成!</div><div style="font-size:12px;color:var(--text-dim);margin-top:6px">建议:结合前3天的学习内容,对照思维导图查漏补缺,然后进行话题测试。</div></div>`;
  html += `</div>`;
  c.innerHTML = html;
}

