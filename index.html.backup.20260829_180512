      <button onclick="setDifficulty('${k}')" class="trans-btn" style="margin:8px;padding:18px 24px;font-size:15px;min-width:200px;text-align:center;border:2px solid ${colors[k]}40;background:${colors[k]}10;">
        <div style="font-weight:800;color:${colors[k]};font-size:18px;margin-bottom:6px">${d.label}</div>
        <div style="font-size:12px;color:var(--text-dim);line-height:1.8">
          ❤️ ${d.lives} · ⏱️ ${d.fallingSpeed/1000}s · ${d.options}选项<br>
          ${d.crossCategory ? '⚠️ 跨类干扰' : '✓ 同类干扰'}
