function getCultivationInfo() {
  if (!memberInfo || !memberInfo.loginTime) return { level: 0, name: '凡人', color: '#888888', petals: 1, cycle: 0 };
  const loginTime = new Date(memberInfo.loginTime);
  const now = new Date();
  const hoursPassed = Math.floor((now - loginTime) / 3600000);

  // 计算等级:道主前每级24h,道主后每级时长翻倍
  let remainingHours = hoursPassed;
  let level = 0;
  for (let i = 0; i < CULTIVATION_LEVELS.length; i++) {
    if (remainingHours >= CULTIVATION_LEVELS[i].hoursNeeded) {
      remainingHours -= CULTIVATION_LEVELS[i].hoursNeeded;
      level = i + 1;
    } else {
      break;
    }
  }
  level = Math.min(level, CULTIVATION_LEVELS.length);

  const cycleLevel = ((level - 1) % 5) + 1; // 1-5 within each cycle
  const cycle = Math.floor((level - 1) / 5); // 0, 1, 2, 3, 4, 5
  const info = CULTIVATION_LEVELS[level - 1] || CULTIVATION_LEVELS[0];
  return { level, name: info.name, color: info.color, glow: info.glow, petals: cycleLevel, cycle, hoursInCurrentLevel: remainingHours };
}

function getCultivationBadge() {
  const info = getCultivationInfo();
  if (info.level <= 0) return '';

  // Generate flower SVG
  const petalCount = info.petals;
  const isDaoMaster = info.level >= 15;
  const isDaluo = info.level >= 14;

  let svg = `<svg width="32" height="32" viewBox="0 0 32 32" style="vertical-align:middle;margin-left:4px;">`;

  // Draw petals
  for (let i = 0; i < petalCount; i++) {
    const angle = (360 / petalCount) * i - 90;
    const rad = angle * Math.PI / 180;
    const x = 16 + 8 * Math.cos(rad);
    const y = 16 + 8 * Math.sin(rad);
    svg += `<circle cx="${x}" cy="${y}" r="3" fill="${isDaluo ? 'url(#rainbow)' : info.color}" opacity="0.9"/>`;
  }

  // Center
  svg += `<circle cx="16" cy="16" r="${petalCount >= 5 ? 5 : 4}" fill="${isDaoMaster ? '#fff' : info.color}" stroke="${isDaoMaster ? 'gold' : 'none'}" stroke-width="${isDaoMaster ? 1 : 0}"/>`;

  // Level number in center for small petals
  if (petalCount < 5) {
    svg += `<text x="16" y="18" text-anchor="middle" fill="#000" font-size="8" font-weight="bold">${info.level}</text>`;
  }

  // Rainbow gradient for 大罗
  if (isDaluo) {
    svg += `<defs><linearGradient id="rainbow" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#ff0000"/><stop offset="16%" stop-color="#ff7f00"/><stop offset="33%" stop-color="#ffff00"/><stop offset="50%" stop-color="#00ff00"/><stop offset="66%" stop-color="#0000ff"/><stop offset="83%" stop-color="#4b0082"/><stop offset="100%" stop-color="#9400d3"/></linearGradient></defs>`;
  }

  svg += `</svg>`;
  return svg;
}

