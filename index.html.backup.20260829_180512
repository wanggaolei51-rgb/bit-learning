.status-badge{display:inline-block;padding:2px 10px;border-radius:12px;font-size:11px;font-weight:500}
.status-operating{background:rgba(34,197,94,.15);color:var(--success)}
.status-construction{background:rgba(245,158,11,.15);color:var(--accent)}
.status-planning{background:rgba(59,130,246,.15);color:var(--info)}
.status-suspended{background:rgba(239,68,68,.15);color:var(--danger)}
.status-other{background:rgba(139,92,246,.15);color:#a78bfa}

