  html += '<div class="chart-box" style="text-align:center;padding:12px"><div style="font-size:13px;color:var(--text);font-weight:600">' + formatCoord(groupData.lat) + '<br>' + formatCoord(groupData.lng) + '</div><div style="font-size:11px;color:var(--text-dim)">坐标</div></div>';
  html += '</div>';

  // 图表区:产能柱状图 + 状态饼图
  html += '<div class="popup-charts">';
  // 产能对比柱状图
  html += '<div class="chart-box"><h5>📊 产能对比 (万镍吨/年)</h5><div class="chart-bars">';
  projects.forEach((p, i) => {
    const cap = parseFloat(p['年产能_万镍金属吨']) || 0;
    const h = Math.max((cap / maxCap) * 100, 4);
    const color = barColors[i % barColors.length];
    const shortName = (p['项目名'] || '').replace(/镍铁|项目|冶炼/ig, '').slice(0, 4) || ('P' + (i + 1));
    html += '<div class="chart-bar" style="height:' + h + '%;background:' + color + '" title="' + escapeHtml(p['项目名'] || '') + ': ' + cap.toFixed(1) + '万镍吨">';
    html += '<div class="chart-bar-val">' + cap.toFixed(1) + '</div>';
    html += '<div class="chart-bar-label">' + escapeHtml(shortName) + '</div>';
    html += '</div>';
  });
  html += '</div></div>';
  // 状态饼图
  html += '<div class="chart-box"><h5>📈 项目状态分布</h5>';
  let pieCss = [];
  let piePct = 0;
  const statusEntries = Object.entries(statusCount);
  statusEntries.forEach(([st, cnt], i) => {
    const pct = cnt / projects.length;
    const color = statusColors[st] || statusColors['其他'];
    pieCss.push(color + ' ' + (piePct * 100).toFixed(2) + '% ' + ((piePct + pct) * 100).toFixed(2) + '%');
    piePct += pct;
  });
  html += '<div class="pie-chart" style="background:conic-gradient(' + pieCss.join(', ') + ')"></div>';
  html += '<div class="pie-legend">';
  statusEntries.forEach(([st, cnt]) => {
    const color = statusColors[st] || statusColors['其他'];
    html += '<div class="pie-legend-item"><div class="pie-dot" style="background:' + color + '"></div><span>' + escapeHtml(st) + ' ' + cnt + '</span></div>';
  });
  html += '</div></div>';
  html += '</div>';

  // 项目明细表格
  html += '<h5 style="font-size:13px;color:var(--primary);margin:16px 0 10px;font-weight:600">📋 项目明细</h5>';
  html += '<table class="popup-table"><thead><tr><th>项目名</th><th>企业</th><th>工艺</th><th>产品</th><th>产能</th><th>状态</th></tr></thead><tbody>';
  projects.forEach(p => {
    const cap = parseFloat(p['年产能_万镍金属吨']) || 0;
    html += '<tr>';
