  setTimeout(()=>tt.classList.remove("show"),4000);
}


// ===== 语音朗读功能 =====
function speakText(text, lang='id-ID') {
  if (!window.speechSynthesis) {
    showToast('❌ 浏览器不支持语音朗读');
    return;
  }
  // 清除队列并恢复(修复微信/移动端只能播放一次的问题)
  window.speechSynthesis.cancel();
  window.speechSynthesis.resume();
  const utterance = new SpeechSynthesisUtterance(text);
  utterance.lang = lang;
  utterance.rate = 0.9;
  utterance.pitch = 1;
  window.speechSynthesis.speak(utterance);
}

function speakIndonesian(text) {
  speakText(text, 'id-ID');
}

function speakEnglish(text) {
  speakText(text, 'en-US');
}

function speakChinese(text) {
  speakText(text, 'zh-CN');
}

// 播放按钮HTML
function speakBtn(text, lang='id') {
  const langMap = {id:'id-ID', en:'en-US', zh:'zh-CN'};
  const l = langMap[lang] || 'id-ID';
  return `<button onclick="speakText('${text.replace(/'/g, "&#39;")}', '${l}')" style="background:none;border:none;color:var(--primary);cursor:pointer;font-size:14px;padding:2px 6px;margin-left:4px;" title="朗读">🔊</button>`;
}

function speak(text,lang){if(!window.speechSynthesis){showToast("不支持语音");return;}const u=new SpeechSynthesisUtterance(text);u.lang=lang==="id"?"id-ID":lang==="zh"?"zh-CN":"en-US";u.rate=0.9;window.speechSynthesis.speak(u);}

function showToast(msg){const t=document.getElementById("toast");t.innerText=msg;t.classList.add("show");setTimeout(()=>t.classList.remove("show"),2500);}

function updateStats(){
  // 累计新词(去重)
  const allNew = new Set();
  const allRev = new Set();
  Object.values(learningHistory).forEach(h => {
    if(h.vocabNew) h.vocabNew.forEach(w => allNew.add(w));
    if(h.vocabReview) h.vocabReview.forEach(w => allRev.add(w));
  });
  const sNew = allNew.size;
  const sRev = allRev.size;
  const sTotal = wordBank.length;

  // 累计学习天数 - 从最早学习日期到今天的天数
  const dates = Object.keys(learningHistory).sort();
  let streak = 0;
  if (dates.length > 0) {
    const firstDate = new Date(dates[0]);
    const now = new Date();
    streak = Math.floor((now - firstDate) / (1000 * 60 * 60 * 24)) + 1;
  }

  const e1=document.getElementById("s-new");if(e1)e1.innerText=sNew;
  const e2=document.getElementById("s-rev");if(e2)e2.innerText=sRev;
  const e3=document.getElementById("s-total");if(e3)e3.innerText=sTotal;
  const e4=document.getElementById("s-streak");if(e4)e4.innerText=streak;
  const e5=document.getElementById("sidebar-today");if(e5){const today2=new Date().toISOString().slice(0,10);e5.innerText=today2;}
}

document.addEventListener("DOMContentLoaded",()=>{
  initHistory();initWordBank();initMember();render();updateStats();syncCourseVocabToWordBank();
  window.addEventListener("hashchange",render);
  document.querySelectorAll(".nav-list li").forEach(li=>{li.addEventListener("click",()=>{const r=li.dataset.route;if(r)navigate(r);});});
  const menuBtn=document.getElementById("menuBtn"),sidebar=document.getElementById("sidebar");
  if(menuBtn)menuBtn.addEventListener("click",()=>sidebar.classList.toggle("open"));
  document.getElementById("main").addEventListener("click",(e)=>{if(window.innerWidth<=768&&sidebar.classList.contains("open"))sidebar.classList.remove("open");});
  // clickable-word 事件委托
  document.getElementById("appContent").addEventListener("click",(e)=>{
    const w = e.target.closest(".clickable-word");
    if(w) showWordPopup(w.dataset.word);
  });

  document.addEventListener("click",(e)=>{if(!e.target.closest(".vocab-card")&&!e.target.closest(".word-card"))document.getElementById("tooltip").classList.remove("show");});
});






