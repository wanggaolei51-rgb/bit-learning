/* ===== NICKEL DATA ADAPTER & MAP FUNCTIONS ===== */
function getNickelItemsFromData() {
  const items = [];
  Object.entries(nickelData.indonesia).forEach(([key, group]) => {
    (group.projects || []).forEach(p => {
      const cap = parseFloat(p['年产能_万镍金属吨']) || 0;
      const statusMap = {'在产':'在产','在建':'在建','规划':'规划','签约':'规划','停产':'停产','维护':'停产维护','部分在产':'部分在产'};
      const st = statusMap[p['状态']] || (p['状态'] || '其他');
      items.push({
        name: p['项目名'] || p['企业名_中文'] || key,
        lat: group.lat,
        lng: group.lng,
        type: p['工艺路线'] || 'RKEF',
        cap: cap > 0 ? cap.toFixed(1) + '万镍吨/年' : '-',
        status: st,
        desc: (p['企业名_中文'] || '') + (p['企业名_英文_PT'] ? ' (' + p['企业名_英文_PT'] + ')' : '') + (p['产品'] ? ' | ' + p['产品'] : '') + (p['投产时间'] ? ' | 投产: ' + p['投产时间'] : '') + (p['主要股东及持股'] ? ' | 股东: ' + p['主要股东及持股'] : '')
      });
    });
  });
  nickelData.global.forEach(p => {
    const cap = parseFloat(p['年产能_万镍金属吨']) || 0;
    const statusMap = {'在产':'在产','在建':'在建','规划':'规划','签约':'规划','停产':'停产'};
    const st = statusMap[p['状态']] || (p['状态'] || '其他');
    items.push({
      name: p['项目名'] || p['企业名_中文'] || p['国家'],
      lat: p.lat,
      lng: p.lng,
      type: '全球',
      cap: cap > 0 ? cap.toFixed(1) + '万镍吨/年' : '-',
      status: st,
      desc: (p['企业名_中文'] || '') + ' | ' + (p['国家'] || '')
    });
  });
  return items;
}

function initFullNickelMap() {
  if (nickelMap) { nickelMap.remove(); nickelMap = null; }
  const mapContainer = document.getElementById('industryMap');
  if (!mapContainer) return;
  mapContainer.innerHTML = '';
  nickelMap = L.map('industryMap').setView([-2.5, 120], 5);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
    attribution: '&copy; OSM & CARTO', subdomains: 'abcd', maxZoom: 19
  }).addTo(nickelMap);
  let indoCount = 0, globalCount = 0, totalCap = 0;
  Object.keys(nickelData.indonesia).forEach(key => {
    const group = nickelData.indonesia[key];
    if (!group.lat || !group.lng) return;
    const count = group.projects.length;
    const cap = group.projects.reduce((s, p) => s + (parseFloat(p['年产能_万镍金属吨']) || 0), 0);
    totalCap += cap; indoCount += count;
    const marker = L.circleMarker([group.lat, group.lng], {
      radius: Math.max(8, Math.min(18, 8 + cap / 5)),
      fillColor: '#00A896', color: '#00d4aa', weight: 2, opacity: 1, fillOpacity: 0.85
    }).addTo(nickelMap);
    marker.bindTooltip('<b>' + escapeHtml(group.park) + '</b><br>' + escapeHtml(group.province) + '<br>' + count + '个项目 · ' + cap.toFixed(1) + '万镍吨', { direction: 'top', offset: [0, -10] });
    marker.on('click', () => showNickelParkPopup(key, group));
  });
  nickelData.global.forEach(p => {
    if (!p.lat || !p.lng) return;
    globalCount++;
    const cap = parseFloat(p['年产能_万镍金属吨']) || 0;
    const color = p['状态'] === '在产' ? '#22c55e' : p['状态'] === '在建' ? '#f59e0b' : '#3b82f6';
    L.circleMarker([p.lat, p.lng], {
      radius: 5, fillColor: color, color: '#fff', weight: 1, opacity: 0.8, fillOpacity: 0.7
    }).addTo(nickelMap).bindTooltip('<b>' + escapeHtml(p['国家']) + '</b><br>' + escapeHtml(p['企业名_中文'] || p['项目名']) + '<br>' + (cap > 0 ? cap.toFixed(1) + '万镍吨' : ''), { direction: 'top' });
  });
  const statsEl = document.getElementById('industryMapStats');
  if (statsEl) statsEl.innerHTML = '🇮🇩 ' + indoCount + '项目 · 🌍 ' + globalCount + '项目 · 总产能 ' + totalCap.toFixed(1) + '万镍吨/年';
  window._nickelStats = { indoCount, globalCount, totalCap };
}

function showNickelParkPopup(key, group) {
  const popup = document.getElementById('nickelPopup');
  const header = document.getElementById('popupHeader');
  const body = document.getElementById('popupBody');
  if (!popup || !header || !body) return;
  const projects = group.projects || [];
  const totalCap = projects.reduce((s, p) => s + (parseFloat(p['年产能_万镍金属吨']) || 0), 0);
  header.innerHTML = '<h4>' + escapeHtml(group.park) + '</h4><button class="popup-close" onclick="closePopup()">×</button>';
  let html = '<div style="margin-bottom:12px"><span style="font-size:13px;color:var(--text-dim)">' + escapeHtml(group.province) + ' · ' + projects.length + '个项目 · 总产能 ' + totalCap.toFixed(1) + '万镍吨/年</span></div>';
  html += '<table class="popup-table"><thead><tr><th>项目名</th><th>企业</th><th>工艺</th><th>产品</th><th>产能</th><th>状态</th></tr></thead><tbody>';
  projects.forEach(p => {
    const cap = parseFloat(p['年产能_万镍金属吨']) || 0;
    html += '<tr>';
    html += '<td>' + escapeHtml(p['项目名'] || '-') + '</td>';
    html += '<td>' + escapeHtml(p['企业名_中文'] || '-') + '<br><span style="font-size:11px;color:var(--text-dim)">' + escapeHtml(p['企业名_英文_PT'] || '') + '</span></td>';
    html += '<td>' + escapeHtml(p['工艺路线'] || '-') + '</td>';
    html += '<td>' + escapeHtml(p['产品'] || '-') + '</td>';
    html += '<td class="cap-num">' + (cap > 0 ? cap.toFixed(1) : '-') + '<span style="font-size:10px;color:var(--text-dim)">万镍吨</span></td>';
    html += '<td><span class="status-badge ' + getStatusClass(p['状态']) + '">' + getStatusLabel(p['状态']) + '</span></td>';
    html += '</tr>';
    const extras = [];
    if (p['产线数']) extras.push('产线: ' + p['产线数']);
    if (p['投产时间']) extras.push('投产: ' + p['投产时间']);
    if (p['主要股东及持股']) extras.push('股东: ' + p['主要股东及持股']);
    if (p['数据来源']) extras.push('来源: ' + p['数据来源']);
    if (p['备注']) extras.push('备注: ' + p['备注']);
    if (extras.length) {
      html += '<tr><td colspan="6" style="padding:4px 10px;font-size:11px;color:var(--text-dim);background:var(--bg-elev);border-bottom:1px solid var(--border)">' + extras.map(e => '<span style="display:inline-block;margin:2px 6px 2px 0;padding:2px 8px;background:rgba(0,212,170,.06);border-radius:4px">' + escapeHtml(e) + '</span>').join('') + '</td></tr>';
