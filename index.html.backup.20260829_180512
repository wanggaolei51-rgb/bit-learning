        html += '<div style="background:var(--bg-elev);border-radius:10px;padding:16px;margin-bottom:12px;border:1px solid var(--border)"><div style="font-size:14px;font-weight:600;color:var(--primary);margin-bottom:8px">' + (gi+1) + '. ' + g.title + '</div>';
        if (g.explanation) html += '<div style="font-size:12px;color:var(--text-dim);margin-bottom:10px;line-height:1.6">' + g.explanation + '</div>';
        if (g.examples && g.examples.length) {
          g.examples.forEach(ex => {
            const _gx = (ex.ind || ex.indonesian || '').replace(/'/g, "\\'");
            html += '<div style="padding:8px;background:var(--bg-card);border-radius:6px;margin-bottom:6px"><div style="font-size:13px;color:var(--text);display:flex;align-items:center;flex-wrap:wrap;">' + wrapClickableWords(ex.ind || ex.indonesian || '') + '<button onclick="speakIndonesian(\'' + _gx + '\')" style="background:none;border:none;color:var(--primary);cursor:pointer;font-size:11px;padding:2px;margin-left:4px;" title="朗读">🔊</button></div>';
            html += '<div style="font-size:12px;color:var(--text-dim);margin-top:3px">🇨🇳 ' + (ex.zhs || ex.chinese || '') + '</div>';
            if (ex.breakdown) html += '<div style="font-size:11px;color:var(--accent);margin-top:3px">🔍 ' + ex.breakdown + '</div>';
            html += '</div>';
          });
        }
        html += '</div>';
      });
    }
  }

  // Passages (all days except map)
  if (lesson.passages && lesson.passages.length) {
    html += '<h3 style="color:var(--primary);margin:16px 0 10px;font-size:15px">🎤 朗读短文</h3>';
    lesson.passages.forEach(p => {
      html += '<div style="background:var(--bg-elev);border-radius:10px;padding:16px;margin-bottom:12px;border:1px solid var(--border)"><div style="font-size:14px;font-weight:600;color:var(--primary);margin-bottom:8px">' + p.title + '</div>';
      const sentencesOrLines = p.lines || p.sentences || []; sentencesOrLines.forEach(s => {
        const _psw = (s.ind || s.indonesian || "").replace(/'/g, "\\'");
        html += '<div style="font-size:13px;color:var(--text);margin:6px 0;padding:8px;background:var(--bg-card);border-radius:6px;display:flex;align-items:center;flex-wrap:wrap;">' + wrapClickableWords(s.ind || s.indonesian || "") + '<button onclick="speakIndonesian(\'' + _psw + '\')" style="background:none;border:none;color:var(--primary);cursor:pointer;font-size:11px;padding:2px;margin-left:4px;" title="朗读">🔊</button></div>';
        html += '<div style="font-size:12px;color:var(--text-dim);margin:4px 0 10px;padding-left:8px;border-left:2px solid var(--primary-dim)">' + (s.zhs || s.chinese || "") + '</div>';
      });
      html += '</div>';
    });
  }

  // Quizzes (all days except map)
  if (lesson.quizzes && lesson.quizzes.length) {
    html += '<h3 style="color:var(--primary);margin:16px 0 10px;font-size:15px">🎯 能力测试</h3>';
    lesson.quizzes.forEach((q, qi) => {
      html += '<div style="background:var(--bg-elev);border-radius:10px;padding:16px;margin-bottom:12px;border:1px solid var(--border)"><div style="font-size:13px;font-weight:600;color:var(--text);margin-bottom:10px">' + (qi+1) + '. ' + q.question + '</div><div style="display:flex;flex-direction:column;gap:8px;">';
      q.options.forEach((opt, oidx) => {
        const isCorrect = oidx === q.answer;
        html += '<div style="padding:8px 12px;background:rgba(30,41,59,0.6);border:1px solid #334155;border-radius:6px;cursor:pointer;font-size:13px;color:#e2e8f0;" onclick="checkNickelQuiz(this, ' + isCorrect + ')">' + opt + '</div>';
      });
      html += '</div></div>';
    });
  }

  html += '</div></div>';
  c.innerHTML = html;
}

function checkNickelQuiz(option, isCorrect) {
  const container = option.closest('div[style*="background:var(--bg-elev)"]');
  if (!container) return;
  const allOpts = container.querySelectorAll('div[style*="cursor:pointer"]');
  allOpts.forEach(opt => { opt.style.cursor = 'default'; opt.onclick = null; });
  if (isCorrect) {
    option.style.background = 'rgba(34,197,94,0.2)'; option.style.borderColor = '#22c55e';
  } else {
    option.style.background = 'rgba(239,68,68,0.2)'; option.style.borderColor = '#ef4444';
    allOpts.forEach(opt => {
      if (opt.getAttribute('onclick') && opt.getAttribute('onclick').includes('true')) {
        opt.style.background = 'rgba(34,197,94,0.2)'; opt.style.borderColor = '#22c55e';
      }
    });
  }
}

