// ===================== NICKEL MAP FUNCTIONS =====================
let nickelMap = null;

function getStatusColor(status) {
  const s = (status || '').toString();
  if (s.includes('在产') && !s.includes('部分') && !s.includes('停产')) return '#22c55e';
  if (s.includes('满负荷')) return '#16a34a';
  if (s.includes('部分在产')) return '#84cc16';
  if (s.includes('在建')) return '#f59e0b';
  if (s.includes('规划')) return '#6b7280';
  if (s.includes('停产') || s.includes('维护')) return '#f97316';
  return '#3b82f6';
}

function getStatusClass(status) {
  const s = (status || '').toString();
  if (s.includes('在产') && !s.includes('部分') && !s.includes('停产')) return 'status-in-production';
  if (s.includes('部分在产')) return 'status-partial';
  if (s.includes('在建')) return 'status-construction';
  if (s.includes('规划')) return 'status-planning';
  if (s.includes('停产') || s.includes('维护')) return 'status-idle';
  return 'status-in-production';
}

function getStatusLabel(status) {
  const s = (status || '').toString();
  if (s.includes('满负荷')) return '在产(满负荷)';
  if (s.includes('在产') && !s.includes('部分') && !s.includes('停产')) return '在产';
  if (s.includes('部分在产')) return '部分在产';
  if (s.includes('在建')) return '在建';
  if (s.includes('规划')) return '规划';
  if (s.includes('停产') || s.includes('维护')) return '停产/维护';
  return s || '未知';
}

function formatCoord(val) {
  if (val === null || val === undefined) return '-';
  return parseFloat(val).toFixed(4);
}

function escapeHtml(str) {
  if (!str) return '-';
  return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}


function switchMapTab(tab) {
  const nView = document.getElementById('map-view');
  const pView = document.getElementById('power-map-view');
  const nTab = document.getElementById('tab-nickel');
  const pTab = document.getElementById('tab-power');
  if (!nView || !pView) return;
  if (tab === 'nickel') {
    nView.style.display = 'block';
    pView.style.display = 'none';
    if (nTab) { nTab.style.background = 'var(--primary)'; nTab.style.color = '#000'; }
    if (pTab) { pTab.style.background = 'var(--bg-elev)'; pTab.style.color = 'var(--text)'; }
  } else {
    nView.style.display = 'none';
    pView.style.display = 'block';
    if (nTab) { nTab.style.background = 'var(--bg-elev)'; nTab.style.color = 'var(--text)'; }
    if (pTab) { pTab.style.background = 'var(--primary)'; pTab.style.color = '#000'; }
    if (!window.powerMapInitialized) {
      setTimeout(initPowerMap, 300);
    }
  }
}

function initPowerMap() {
  if (window.powerMap) { window.powerMap.remove(); }
  const container = document.getElementById('power-map');
  if (!container) return;
  container.innerHTML = '';
  const pm = L.map('power-map').setView([-2.5, 118], 5);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors',
    maxZoom: 18
  }).addTo(pm);
  window.powerMap = pm;
  window.powerMapInitialized = true;

  const iconColors = {
    substation: '#3498db', hydro: '#2980b9', coal: '#e74c3c', gas: '#f39c12',
    geothermal: '#9b59b6', solar: '#f1c40f', wind: '#1abc9c', diesel: '#95a5a6'
  };

  // Power plants and substations
  const allItems = [];
  if (powerData.indonesia) {
    if (powerData.indonesia.powerPlants) allItems.push(...powerData.indonesia.powerPlants);
    if (powerData.indonesia.substations) allItems.push(...powerData.indonesia.substations);
  }

  allItems.forEach(item => {
    const color = iconColors[item.type] || '#888';
    const marker = L.circleMarker([item.lat, item.lng], {
      radius: item.type === 'substation' ? 6 : 8,
      fillColor: color, color: '#fff', weight: 1.5, opacity: 1, fillOpacity: 0.85
    }).addTo(pm);

    let popup = '<b>' + item.name + '</b><br>';
    popup += '类型: ' + (item.type === 'substation' ? '变电站' : item.type === 'hydro' ? '水电站' : item.type === 'coal' ? '火电站' : item.type === 'gas' ? '燃气电站' : item.type === 'geothermal' ? '地热电站' : item.type === 'solar' ? '光伏电站' : item.type === 'wind' ? '风电场' : item.type === 'diesel' ? '柴油电站' : '电站') + '<br>';
    popup += '省份: ' + (item.province || '') + '<br>';
    if (item.capacity) popup += '容量: ' + (item.type === 'substation' ? item.capacity : item.capacity + ' MW') + '<br>';
    if (item.voltage) popup += '电压: ' + item.voltage + '<br>';
    if (item.status) popup += '状态: ' + item.status + '<br>';
    if (item.operator) popup += '运营商: ' + item.operator + '<br>';
    if (item.note) popup += '<span style="font-size:11px;color:#666">' + item.note + '</span>';
    marker.bindPopup(popup);
  });

  // Transmission lines
  if (powerData.indonesia && powerData.indonesia.transmissionLines) {
    powerData.indonesia.transmissionLines.forEach(line => {
      const fromItem = allItems.find(x => x.name === line.from);
      const toItem = allItems.find(x => x.name === line.to);
      if (fromItem && toItem) {
        L.polyline([[fromItem.lat, fromItem.lng], [toItem.lat, toItem.lng]], {
          color: '#e67e22', weight: 2, opacity: 0.7, dashArray: '5,5'
        }).addTo(pm).bindPopup('<b>' + line.name + '</b><br>电压: ' + line.voltage + '<br>长度: ' + line.length);
      }
    });
  }

  const statsEl = document.getElementById('powerMapStats');
  if (statsEl && powerData.indonesia) {
    const pp = powerData.indonesia.powerPlants ? powerData.indonesia.powerPlants.length : 0;
    const ss = powerData.indonesia.substations ? powerData.indonesia.substations.length : 0;
    const tl = powerData.indonesia.transmissionLines ? powerData.indonesia.transmissionLines.length : 0;
    statsEl.textContent = '电力设施: ' + pp + ' 电站 + ' + ss + ' 变电站 | 输电线路: ' + tl + ' 条';
  }
}

function closePopup() {
  document.getElementById('nickelPopup').classList.remove('active');
}

// Draggable popup
(function() {
  const popup = document.getElementById('nickelPopup');
  const header = document.getElementById('popupHeader');
  if (!popup || !header) return;
  let isDragging = false, startX, startY, initialLeft, initialTop;
  header.addEventListener('mousedown', function(e) {
    isDragging = true;
    startX = e.clientX; startY = e.clientY;
    const rect = popup.getBoundingClientRect();
    initialLeft = rect.left; initialTop = rect.top;
    popup.style.transition = 'none';
    e.preventDefault();
  });
  document.addEventListener('mousemove', function(e) {
    if (!isDragging) return;
    popup.style.left = (initialLeft + e.clientX - startX) + 'px';
    popup.style.top = (initialTop + e.clientY - startY) + 'px';
    popup.style.right = 'auto';
  });
  document.addEventListener('mouseup', function() {
    if (isDragging) { isDragging = false; popup.style.transition = ''; }
  });
})();

function showIndonesiaPopup(key, groupData) {
