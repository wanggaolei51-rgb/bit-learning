        <div style="font-weight:800;color:var(--primary);font-size:17px;margin-bottom:6px;letter-spacing:.5px">${d.name.split(' ')[0]}</div>
        <div style="font-size:12px;color:var(--text-dim);margin-bottom:4px">${d.name.split(' ').slice(1).join(' ')}</div>
        <div style="font-size:11px;color:var(--accent);margin-top:6px">${varCount} 种变体 · ${totalWords} 个词根</div>
        <div style="font-size:11px;color:var(--text-dim);margin-top:4px;line-height:1.5;opacity:.8">${d.desc.substring(0,40)}...</div>
