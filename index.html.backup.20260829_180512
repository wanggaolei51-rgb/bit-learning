    const marker = L.circleMarker([item.lat, item.lng], {
      radius: 10,
      fillColor: data.color,
      color: '#fff',
      weight: 2,
      opacity: 1,
      fillOpacity: 0.85
    }).addTo(industryMap);
    
    marker.bindTooltip('<b>' + item.name + '</b><br>' + item.type + ' · ' + item.status, { direction: 'top', offset: [0, -10] });
    
