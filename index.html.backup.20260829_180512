  const groups = groupConfig[tab];
  let grouped = {};
  if(groups){
    // Group items by type (sorted by specificity: longer/more specific keys first)
    const sortedGroups = Object.entries(groups).sort((a, b) => b[0].length - a[0].length);
    data.items.forEach(item => {
      let found = false;
      for(const [key, cfg] of sortedGroups){
        if(item.type && item.type.includes(key)){
          if(!grouped[key]) grouped[key] = [];
          grouped[key].push(item);
          found = true;
          break;
        }
