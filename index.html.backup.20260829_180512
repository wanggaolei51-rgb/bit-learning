    // 后台自动查询
    setTimeout(()=>{
      Promise.all([gTrans(word,'id','zh-CN'),gTrans(word,'id','en')]).then(([zhText,enText])=>{
        const statusEl = document.getElementById('autoQueryStatus');
        const resultEl = document.getElementById('autoQueryResult');
