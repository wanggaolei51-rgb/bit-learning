  }
  html += `</div>`;

// === 艾宾浩斯记忆曲线 SVG V4:曲线 + 列表形式,纵向排列复习内容 ===
  // 收集所有学习日期(topicCalendar + learningHistory中已学习的日期)
  const topicDates = Object.keys(topicCalendar);
  const historyDates = Object.keys(learningHistory).filter(d => {
    const rec = learningHistory[d];
    return rec && (rec.vocabNew?.length > 0 || rec.vocabReview?.length > 0 || rec.topics?.length > 0);
  });
  const learnDates = [...new Set([...topicDates, ...historyDates])].sort();
  const firstDate = new Date(learnDates[0] || '2026-07-14');
  const todayDate = new Date(today);
  const futureDate = new Date(todayDate);
  futureDate.setDate(todayDate.getDate() + 45);

  const totalDays = Math.ceil((futureDate - firstDate) / (1000 * 60 * 60 * 24)) + 1;
  const dayWidth = 20;
  const leftMargin = 60;
  const rightMargin = 40;
  const svgWidth = Math.max(800, leftMargin + totalDays * dayWidth + rightMargin);
  const svgHeight = 300;

  // 收集复习点
  const allPoints = [];
  const learnDatePoints = [];
  // 按日期分组的复习清单
  const reviewListByDate = {};

  learnDates.forEach(ld => {
    const baseDate = new Date(ld);
    const daysFromFirst = Math.ceil((baseDate - firstDate) / (1000 * 60 * 60 * 24));
    const x = leftMargin + daysFromFirst * dayWidth;
    const topicInfo = topicCalendar[ld];
    const topicItem = topicInfo ? topicData[topicInfo.topic] : null;

    const isToday = ld === today;
    const isPast = ld < today;
    const color = isToday ? 'var(--danger)' : (isPast ? 'var(--primary)' : 'var(--info)');

    learnDatePoints.push({
      x, dateStr: ld, topicTitle: topicItem ? topicItem.title : '学习内容',
      label: topicInfo ? topicInfo.label : '', color
    });

    [1, 2, 4, 7, 15, 30, 60, 90].forEach(interval => {
      const reviewDate = new Date(baseDate);
      reviewDate.setDate(baseDate.getDate() + interval);
      const reviewStr = reviewDate.toISOString().split('T')[0];

      if (reviewDate >= firstDate && reviewDate <= futureDate) {
        const rDaysFromFirst = Math.ceil((reviewDate - firstDate) / (1000 * 60 * 60 * 24));
        const rx = leftMargin + rDaysFromFirst * dayWidth;
        const retention = Math.exp(-interval / 10);
        const ry = 20 + 180 * (1 - retention);

        const isRToday = reviewStr === today;
        const isRPast = reviewStr < today;
        const isReviewed = learningHistory[reviewStr] && learningHistory[reviewStr].reviews && learningHistory[reviewStr].reviews.length > 0;

        let rColor = 'var(--text-dim)';
        if (isRToday) rColor = 'var(--danger)';
        else if (isReviewed) rColor = 'var(--success)';
        else if (isRPast) rColor = 'var(--accent)';

        let status = isReviewed ? '✅已复习' : (isRToday ? '⏰今天' : (isRPast ? '⚠️待复习' : '📅未来'));
        let content = topicItem ? `${topicItem.title} (${topicInfo.day || 1}天课程)` : '已学内容';

        let route = '';
        if (topicCalendar[reviewStr]) route = `date/${reviewStr}`;
        else if (isRPast || isRToday) route = 'review';

        allPoints.push({
          x: rx, y: ry, interval, reviewStr, baseDate: ld,
          topicTitle: topicItem ? topicItem.title : '已学内容',
          content, status, color: rColor, route
        });

        // 添加到复习清单
        if (!reviewListByDate[reviewStr]) {
          reviewListByDate[reviewStr] = {
            dateStr: reviewStr,
            isToday: isRToday,
            isPast: isRPast,
            items: []
          };
        }
        reviewListByDate[reviewStr].items.push({
          baseDate: ld,
          interval,
          content,
          status,
          color: rColor,
          route
        });
      }
    });
  });

  // 同一天复习点垂直堆叠
  const pointsByDate = {};
  allPoints.forEach(p => {
    if (!pointsByDate[p.reviewStr]) pointsByDate[p.reviewStr] = [];
    pointsByDate[p.reviewStr].push(p);
  });
  Object.values(pointsByDate).forEach(group => {
    if (group.length > 1) {
      const offsetStep = 18;
      group.forEach((p, i) => {
        p.finalY = p.y + (i - (group.length - 1) / 2) * offsetStep;
        if (p.finalY < 15) p.finalY = 15;
        if (p.finalY > 220) p.finalY = 220;
      });
    } else {
      group[0].finalY = group[0].y;
    }
  });

  // 刻度标签
  const tickDates = [];
  for (let d = 0; d <= totalDays; d += 5) {
    const tickDate = new Date(firstDate);
