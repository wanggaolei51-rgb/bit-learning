  // 词缀剥离:支持印尼语前缀/后缀查询
  if(!v){
    const w=word.toLowerCase();
    const prefixes=['ber','me','mem','men','meng','meny','pe','pem','pen','peng','peny','di','ter','se','ke','per','pel'];
    const suffixes=['kan','i','an','lah','nya','pun'];
    for(const pre of prefixes){if(w.startsWith(pre)&&w.length>pre.length+2){const root=w.slice(pre.length);if(vocabDB[root]||vocabDB[root.charAt(0).toUpperCase()+root.slice(1)]){v=vocabDB[root]||vocabDB[root.charAt(0).toUpperCase()+root.slice(1)];break;}}}
    if(!v){for(const suf of suffixes){if(w.endsWith(suf)&&w.length>suf.length+2){const root=w.slice(0,-suf.length);if(vocabDB[root]||vocabDB[root.charAt(0).toUpperCase()+root.slice(1)]){v=vocabDB[root]||vocabDB[root.charAt(0).toUpperCase()+root.slice(1)];break;}}}}
  }
