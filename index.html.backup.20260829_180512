function startTopicQuiz(topicKey) {
  const c = document.getElementById('appContent');
  if (!c) return;

  const topic = topicData[topicKey];
  if (!topic) {
    showToast('话题不存在');
    return;
  }

  // 获取话题相关词汇
  const topicWords = [];
  Object.keys(vocabDB).forEach(k => {
    const v = vocabDB[k];
    if (v.tag && (v.tag.includes(topicKey) || topicKey.includes(v.tag))) {
      topicWords.push({word: k, data: v});
    }
  });

  // 如果话题词汇不足,添加所有词汇
  if (topicWords.length < 5) {
    Object.keys(vocabDB).forEach(k => {
      if (!topicWords.find(w => w.word === k)) {
        topicWords.push({word: k, data: vocabDB[k]});
      }
    });
  }

  if (topicWords.length === 0) {
    c.innerHTML = `<div class="card"><div class="card-header"><h2>🎯 ${topic.title || topicKey} 测试</h2></div><div style="padding:20px;text-align:center;color:var(--text-dim);">该话题暂无词汇</div></div>`;
    return;
  }

  // 随机选10题(比之前更多)
  const shuffled = topicWords.sort(() => Math.random() - 0.5).slice(0, 10);
  const questions = shuffled.map(w => {
    const wrong = Object.keys(vocabDB).filter(k => k !== w.word && vocabDB[k].cn).slice(0, 3).map(k => vocabDB[k].cn);
    return {word: w.word, data: w.data, wrong};
  });

  quizState = {q: 0, correct: 0, total: questions.length, done: 0, questions};

  c.innerHTML = `<div class="card"><div class="card-header" style="flex-wrap:wrap;gap:8px;"><h2>🎯 ${topic.title || topicKey} 课时测试 / Ujian Pelajaran</h2><span class="badge">${questions.length}题 / soal</span></div><div id="quizArea" style="padding:16px;"></div></div>`;

  const t = document.getElementById('pageTitle');
  if (t) t.innerText = `🎯 ${topic.title || topicKey}`;
  currentRoute = 'topicquiz';
  updateNav();
  showQuizQ();
}

