function generateTopic() {
  if (!checkAccess("话题生成")) return;

  const name = document.getElementById("genTopicName").value.trim();
  const icon = document.getElementById("genTopicIcon").value;
  const date = document.getElementById("genTopicDate").value;
  const days = parseInt(document.getElementById("genTopicDays").value);
  const vocabText = document.getElementById("genTopicVocab").value.trim();
  const grammar = document.getElementById("genTopicGrammar").value.trim();
  const scenesDesc = document.getElementById("genTopicScenes").value.trim();

  if (!name || !date) {
    showToast("请填写话题名称和日期");
    return;
  }

  if (topicCalendar[date]) {
    showToast("该日期已有课程,请选择其他日期");
    return;
  }

  const vocabList = parseVocabInput(vocabText);
  const topicNum = Object.keys(topicData).length + 1;
  const topicKey = "topic_" + Date.now();

  // 生成词汇数组 [word, cn, ipa]
  const vocabArray = vocabList.map(v => [v.word, v.cn, v.ipa]);

  // 生成场景
  const scenes = generateAutoScenes(name, vocabList, scenesDesc);

  // 生成演讲
  const speeches = generateAutoSpeeches(name, vocabList);

  // 构建话题数据
  const newTopic = {
    title: `话题${topicNum}: ${name}`,
    icon: icon,
    days: days,
    desc: `${name}专题课程,涵盖核心词汇、语法规则、场景对话和演讲练习。`,
    grammar: {
      title: grammar || `${name}核心语法`,
      rules: [
        `Rule 1: 掌握${name}场景中的核心词汇用法`,
        `Rule 2: 理解印尼语在${name}语境中的表达习惯`,
        `Rule 3: 熟练运用相关语法结构进行有效沟通`
      ],
      examples: vocabList.slice(0, 3).map(v => `${v.word} = '${v.cn}'`)
    },
    vocab: vocabArray,
    scenes: scenes,
    speeches: speeches
  };

  // 添加到 topicData(运行时)
  topicData[topicKey] = newTopic;

  // 添加到 topicCalendar(运行时)
  const startDate = new Date(date);
  for (let i = 0; i < days; i++) {
    const d = new Date(startDate);
    d.setDate(d.getDate() + i);
    const ds = d.toISOString().slice(0, 10);
    const dayLabels = ["语法+词汇", "场景对话", "演讲+测试", "深度练习", "综合复习"];
    topicCalendar[ds] = {
      topic: topicKey,
      day: i + 1,
      label: `${icon} ${name} · ${dayLabels[i] || "第" + (i+1) + "天"}`
    };
  }

  // 保存到 localStorage
  const customTopics = JSON.parse(localStorage.getItem("bir_custom_topics") || "{}");
  customTopics[topicKey] = { topic: newTopic, startDate: date, days: days };
  localStorage.setItem("bir_custom_topics", JSON.stringify(customTopics));

  const customCalendar = JSON.parse(localStorage.getItem("bir_custom_calendar") || "{}");
  Object.keys(topicCalendar).forEach(ds => {
    if (topicCalendar[ds].topic === topicKey) {
      customCalendar[ds] = topicCalendar[ds];
    }
  });
  localStorage.setItem("bir_custom_calendar", JSON.stringify(customCalendar));

  // 显示结果
  const resultDiv = document.getElementById("topicResult");
  resultDiv.style.display = "block";
  resultDiv.innerHTML = `
    <div style="background:rgba(34,197,94,.1);border-radius:10px;padding:16px;border:2px solid var(--success)">
      <div style="font-size:16px;color:var(--success);font-weight:700;margin-bottom:12px">✅ 话题课程生成成功!</div>
      <div style="font-size:14px;color:var(--text);margin-bottom:12px">
        <strong>${icon} 话题${topicNum}: ${name}</strong><br>
        📅 ${date} 起 ${days} 天课程<br>
        🎯 ${vocabList.length} 个核心词汇<br>
        🎭 ${scenes.length} 个场景对话<br>
        🎤 ${speeches.length} 篇演讲
      </div>
      <div style="background:var(--bg-card);border-radius:8px;padding:12px;font-size:12px;color:var(--text-dim)">
        💾 课程已保存到本地存储,刷新页面后仍然可用<br>
        📌 话题编号: <strong>${topicKey}</strong><br>
        📍 日历入口: ${date} 等 ${days} 个日期
      </div>
      <div style="margin-top:12px;display:flex;gap:10px">
        <button onclick="navigate('calendar')" class="trans-btn" style="flex:1;background:var(--primary);color:#000">📅 查看日历</button>
        <button onclick="navigate('topicquiz','${topicKey}')" class="trans-btn" style="flex:1;background:var(--accent);color:#000">🎯 话题测试</button>
      </div>
    </div>
  `;

  showToast(`✅ 话题${topicNum}「${name}」生成成功!`);
  updateStats();

  // 3秒后自动跳转到日历
  setTimeout(() => {
    navigate('calendar');
  }, 3000);
}

