        html += '<div style="background:var(--bg-card);padding:12px;border-radius:8px;border-left:3px solid ' + data.color + '">';
        html += '<div style="font-weight:600;font-size:13px;margin-bottom:6px">' + item.name + '</div>';
        html += '<div style="font-size:11px;color:var(--text-dim);line-height:1.6">';
        html += '<div>📍 ' + item.type + '</div>';
        html += '<div>⚡ ' + item.cap + '</div>';
        html += '<div>🟢 <span style="color:' + statusColor + '">' + item.status + '</span></div>';
        html += '<div style="margin-top:4px">' + item.desc + '</div>';
        html += '</div></div>';
      });
      html += '</div></div>';
    }
  } else {
    // Fallback: render all items without grouping
    html += '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px">';
    data.items.forEach(item => {
      const statusColor = item.status==='在产'?'#22c55e':item.status==='在建'?'#f59e0b':item.status==='停产维护'?'#ef4444':'#3b82f6';
      html += '<div style="background:var(--bg-card);padding:12px;border-radius:8px;border-left:3px solid ' + data.color + '">';
      html += '<div style="font-weight:600;font-size:13px;margin-bottom:6px">' + item.name + '</div>';
      html += '<div style="font-size:11px;color:var(--text-dim);line-height:1.6">';
      html += '<div>📍 ' + item.type + '</div>';
      html += '<div>⚡ ' + item.cap + '</div>';
      html += '<div>🟢 <span style="color:' + statusColor + '">' + item.status + '</span></div>';
      html += '<div style="margin-top:4px">' + item.desc + '</div>';
      html += '</div></div>';
    });
    html += '</div>';
  }
  
  html += '</div>';
  c.innerHTML = html;
  
  // Render summary table
  renderIndustrySummary(tab);
}

function switchNickelTab(){
  // Use full nickelData for map and content
  const container = document.getElementById('industryMapContainer');
  if(!container) return;
  
  // Re-init map for nickel view
  if(industryMap) { industryMap.remove(); industryMap = null; }
  container.innerHTML = '';
  industryMap = L.map('industryMapContainer').setView([-2.5, 120], 5);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
    attribution: '&copy; OSM & CARTO', subdomains: 'abcd', maxZoom: 19
  }).addTo(industryMap);
  
  let indoCount = 0, globalCount = 0, totalCap = 0;
  
  // Add Indonesia parks
  Object.keys(nickelData.indonesia).forEach(key => {
    const group = nickelData.indonesia[key];
    if (!group.lat || !group.lng) return;
    const count = group.projects.length;
    const cap = group.projects.reduce((s, p) => s + (parseFloat(p['年产能_万镍金属吨']) || 0), 0);
    totalCap += cap; indoCount += count;
    const marker = L.circleMarker([group.lat, group.lng], {
      radius: Math.max(8, Math.min(18, 8 + cap / 5)),
      fillColor: '#00A896', color: '#00d4aa', weight: 2, opacity: 1, fillOpacity: 0.85
    }).addTo(industryMap);
    marker.bindTooltip('<b>' + escapeHtml(group.park) + '</b><br>' + escapeHtml(group.province) + '<br>' + count + '个项目 · ' + cap.toFixed(1) + '万镍吨', { direction: 'top', offset: [0, -10] });
    marker.on('click', () => showNickelParkPopup(key, group));
  });
  
  // Add global projects
  nickelData.global.forEach(p => {
    if (!p.lat || !p.lng) return;
    globalCount++;
    const cap = parseFloat(p['年产能_万镍金属吨']) || 0;
    const color = p['状态'] === '在产' ? '#22c55e' : p['状态'] === '在建' ? '#f59e0b' : '#3b82f6';
    L.circleMarker([p.lat, p.lng], {
      radius: 5, fillColor: color, color: '#fff', weight: 1, opacity: 0.8, fillOpacity: 0.7
    }).addTo(industryMap).bindTooltip('<b>' + escapeHtml(p['国家']) + '</b><br>' + escapeHtml(p['企业名_中文'] || p['项目名']) + '<br>' + (cap > 0 ? cap.toFixed(1) + '万镍吨' : ''), { direction: 'top' });
  });
  
  // Update stats
  const statsEl = document.getElementById('industryStats');
  if(statsEl){
    statsEl.innerHTML = '🇮🇩 ' + indoCount + '项目 · 🌍 ' + globalCount + '项目 · 总产能 ' + totalCap.toFixed(1) + '万镍吨/年';
  }
  window._nickelStats = { indoCount, globalCount, totalCap };
  
  // Update content with full project list grouped by park
  const c = document.getElementById('industryContent');
  if(!c) return;
  
  let html = '<div style="background:var(--bg-elev);border-radius:10px;padding:14px;border:1px solid var(--border)">';
  html += '<h3 style="color:var(--primary);font-size:15px;margin-bottom:12px">🔥 镍冶炼项目详情（完整数据）</h3>';
  
  // Group by province
  const byProvince = {};
  Object.entries(nickelData.indonesia).forEach(([key, group]) => {
    const prov = group.province || '其他';
    if(!byProvince[prov]) byProvince[prov] = [];
    byProvince[prov].push({key, group});
  });
  
  for(const [prov, parks] of Object.entries(byProvince)){
    html += '<div style="margin-bottom:16px">';
    html += '<div style="font-size:14px;font-weight:600;color:var(--primary);margin-bottom:8px;padding:8px 12px;background:rgba(0,212,170,.1);border-radius:6px">📍 ' + escapeHtml(prov) + '</div>';
    
    for(const {key, group} of parks){
      const parkCap = group.projects.reduce((s, p) => s + (parseFloat(p['年产能_万镍金属吨']) || 0), 0);
      html += '<div style="margin:8px 0;padding:10px;background:var(--bg-card);border-radius:8px;border-left:3px solid #00d4aa">';
      html += '<div style="font-weight:600;font-size:13px;color:var(--primary);margin-bottom:6px">' + escapeHtml(group.park) + ' · ' + group.projects.length + '个合作商 · 产能 ' + parkCap.toFixed(1) + '万镍吨/年</div>';
      html += '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:8px">';
      
      group.projects.forEach(p => {
        const cap = parseFloat(p['年产能_万镍金属吨']) || 0;
        const statusColor = p['状态']==='在产'?'#22c55e':p['状态']==='在建'?'#f59e0b':p['状态']==='停产'?'#ef4444':'#8b95a8';
        html += '<div style="padding:8px;background:var(--bg-elev);border-radius:6px;font-size:11px">';
        html += '<div style="font-weight:600;color:var(--text);margin-bottom:2px">' + escapeHtml(p['企业名_中文'] || p['项目名'] || '-') + '</div>';
        html += '<div style="color:var(--text-dim)">' + escapeHtml(p['工艺路线'] || '-') + ' · ' + (cap > 0 ? cap.toFixed(1) + '万镍吨' : '-') + '</div>';
        html += '<div style="margin-top:2px"><span style="display:inline-block;padding:1px 6px;border-radius:4px;background:' + statusColor + '20;color:' + statusColor + ';font-size:10px">' + (p['状态'] || '其他') + '</span></div>';
        if(p['产品']) html += '<div style="color:var(--text-dim);margin-top:2px">产品: ' + escapeHtml(p['产品']) + '</div>';
        if(p['投产时间']) html += '<div style="color:var(--text-dim)">投产: ' + escapeHtml(p['投产时间']) + '</div>';
        html += '</div>';
      });
      
      html += '</div></div>';
    }
    html += '</div>';
  }
  
  // Global projects section
  if(nickelData.global && nickelData.global.length > 0){
    const globalWithCap = nickelData.global.filter(p => parseFloat(p['年产能_万镍金属吨']) > 0);
    html += '<div style="margin-bottom:16px">';
    html += '<div style="font-size:14px;font-weight:600;color:var(--primary);margin-bottom:8px;padding:8px 12px;background:rgba(59,130,246,.1);border-radius:6px">🌍 全球项目（' + globalWithCap.length + '个有产能数据）</div>';
    html += '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:8px">';
    globalWithCap.forEach(p => {
      const cap = parseFloat(p['年产能_万镍金属吨']) || 0;
      html += '<div style="padding:8px;background:var(--bg-elev);border-radius:6px;font-size:11px">';
      html += '<div style="font-weight:600;color:var(--text)">' + escapeHtml(p['国家']) + ' · ' + escapeHtml(p['企业名_中文'] || p['项目名'] || '-') + '</div>';
      html += '<div style="color:var(--text-dim)">产能: ' + cap.toFixed(1) + '万镍吨/年</div>';
      html += '</div>';
    });
    html += '</div></div>';
  }
  
  html += '</div>';
  c.innerHTML = html;
  
  // Render park summary table
  renderNickelSummary();
}

