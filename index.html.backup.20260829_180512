function selectAffixLevel1(cat) {
  prefixGameState.level1 = cat;
  prefixGameState.phase = 'difficulty';
  prefixGameState.active = true;
  showDifficultySelect(document.getElementById('appContent'));
}

// === 难度选择 ===
