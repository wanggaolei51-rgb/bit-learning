  c.innerHTML = `
    <div class="card">
      <div class="card-header" style="flex-wrap:wrap;gap:8px;">
        <h2>${catData.icon} ${catData.name}</h2>
        <div style="display:flex;gap:8px;">
          <span class="badge" style="background:rgba(59,130,246,.15);color:#3b82f6">${DIFFICULTY_CONFIG[state.difficulty].label}</span>
          <button onclick="backToAffixLevel1()" class="trans-btn" style="font-size:12px;padding:6px 12px;">← 返回大类</button>
        </div>
      </div>
      <div style="padding:24px;">
        <div style="font-size:13px;color:var(--text-dim);margin-bottom:20px;padding:14px;background:rgba(0,212,170,.06);border-radius:10px;border-left:3px solid var(--primary);line-height:1.7">
